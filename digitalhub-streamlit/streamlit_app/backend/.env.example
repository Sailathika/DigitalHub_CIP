# --- App ---
APP_NAME=DigitalHub API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# --- CORS (comma-separated origins allowed to call this API) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Defaults to local SQLite (no server needed). Set DB_ENGINE=postgres to use
# the POSTGRES_* settings below instead, once a PostgreSQL server is available.
DB_ENGINE=sqlite

POSTGRES_USER=shopsense
POSTGRES_PASSWORD=shopsense
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shopsense
# Or override everything above with a single URL (e.g. managed Postgres):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# --- JWT ---
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=50

# --- MLflow ---
MLFLOW_TRACKING_URI=file:///./mlruns
MLFLOW_EXPERIMENT_NAME=shopsense

# --- Default admin account (seeded on first startup) ---
DEFAULT_ADMIN_EMAIL=admin@digitalhub.io
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
